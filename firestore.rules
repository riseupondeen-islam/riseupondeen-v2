    /* =========================================================
       RISK SIGNALS
       
       Signals are safety indicators only.
       They must not automatically ban a user.
       ========================================================= */

    match /deens_risk_signals/{signalId} {
      // Explicit Deen Friends Super Admin override.
      allow read, create, update, delete: if isSuperAdmin();



      allow read:
        if
          isTrustSafetyAdmin()
          || isSuperAdmin();

      allow create:
        if
          isTrustSafetyAdmin()
          || isSuperAdmin();

      allow update:
        if
          isTrustSafetyAdmin()
          || isSuperAdmin();

      allow delete:
        if isSuperAdmin();
    }


    /* =========================================================
       ACTIVITY LOGS
       ========================================================= */

    match /deens_activity_logs/{activityId} {
      // Explicit Deen Friends Super Admin override.
      allow read, create, update, delete: if isSuperAdmin();



      allow read:
        if
          isTrustSafetyAdmin()
          || isCommunityAdmin()
          || isSuperAdmin();

      allow create:
        if
          signedIn() &&
          (
            request.resource.data.uid == request.auth.uid ||
            isTrustSafetyAdmin() ||
            isSuperAdmin()
          ) &&
          isString(request.resource.data.eventType, 100) &&
          request.resource.data.createdAt is timestamp;

      allow update, delete:
        if false;
    }


    /* =========================================================
       ADMIN AUDIT LOGS
       
       Immutable.
       No update/delete.
       ========================================================= */

    match /deens_admin_audit_logs/{auditId} {
      // Explicit Deen Friends Super Admin override.
      allow read, create, update, delete: if isSuperAdmin();



      allow read:
        if
          isSuperAdmin()
          || isTrustSafetyAdmin();

      allow create:
        if
          isAdmin() &&
          request.resource.data.adminUid == request.auth.uid &&
          isString(request.resource.data.action, 120) &&
          isString(request.resource.data.target, 500) &&
          isString(request.resource.data.reason, 1000) &&
          request.resource.data.timestamp is timestamp;

      allow update, delete:
        if false;
    }


    /* =========================================================
       PRIVATE CHAT ACCESS REQUESTS
       
       This collection is the security gate for private
       conversation access.

       Only Super Admin or admins carrying the explicit
       VIEW_PRIVATE_MESSAGES permission can create access.

       The application should create this document only after:
         1. Reason entered
         2. Case ID supplied
         3. Explicit confirmation
         4. Audit event recorded
       ========================================================= */

    match /deens_private_chat_access/{accessId} {
      // Explicit Deen Friends Super Admin override.
      allow read, create, update, delete: if isSuperAdmin();



      allow read:
        if
          isSuperAdmin()
          || (
            hasPrivateMessagePermission() &&
            resource.data.adminUid == request.auth.uid
          );

      allow create:
        if
          hasPrivateMessagePermission() &&
          request.resource.data.adminUid == request.auth.uid &&
          isString(request.resource.data.friendshipId, 260) &&
          isString(request.resource.data.reason, 1000) &&
          isString(request.resource.data.caseId, 160) &&
          request.resource.data.active == true &&
          request.resource.data.createdAt is timestamp;

      allow update:
        if
          isSuperAdmin()
          ||
          (
            hasPrivateMessagePermission() &&
            resource.data.adminUid == request.auth.uid &&
            request.resource.data.adminUid == resource.data.adminUid &&
            request.resource.data.friendshipId == resource.data.friendshipId &&
            request.resource.data.caseId == resource.data.caseId &&
            request.resource.data.reason == resource.data.reason &&
            request.resource.data.active == false
          );

      allow delete:
        if isSuperAdmin();
    }


    /* =========================================================
       PRIVATE CHAT ACCESS AUDIT
       
       Immutable.
       ========================================================= */

    match /deens_private_chat_access_logs/{logId} {
      // Explicit Deen Friends Super Admin override.
      allow read, create, update, delete: if isSuperAdmin();



      allow read:
        if
          isSuperAdmin()
          || isTrustSafetyAdmin();

      allow create:
        if
          hasPrivateMessagePermission() &&
          request.resource.data.adminUid == request.auth.uid &&
          isString(request.resource.data.conversationId, 260) &&
          isString(request.resource.data.reason, 1000) &&
          isString(request.resource.data.caseId, 160) &&
          request.resource.data.timestamp is timestamp;

      allow update, delete:
        if false;
    }


    /* =========================================================
       COMMUNITY NOTICES
       ========================================================= */

    match /deens_community_notices/{noticeId} {
      // Explicit Deen Friends Super Admin override.
      allow read, create, update, delete: if isSuperAdmin();



      allow read:
        if
          signedIn() &&
          (
            resource.data.published == true ||
            isCommunityAdmin() ||
            isTrustSafetyAdmin() ||
            isSuperAdmin()
          );

      allow create:
        if
          isCommunityAdmin()
          || isTrustSafetyAdmin()
          || isSuperAdmin();

      allow update:
        if
          isCommunityAdmin()
          || isTrustSafetyAdmin()
          || isSuperAdmin();

      allow delete:
        if
          isTrustSafetyAdmin()
          || isSuperAdmin();
    }


    /* =========================================================
       DEEN FRIENDS ADMIN SETTINGS
       ========================================================= */

    match /deens_admin_settings/{settingId} {
      // Explicit Deen Friends Super Admin override.
      allow read, create, update, delete: if isSuperAdmin();



      allow read:
        if
          isSuperAdmin()
          || isTrustSafetyAdmin()
          || isCommunityAdmin()
          || isAnalyticsAdmin();

      allow create, update:
        if isSuperAdmin();

      allow delete:
        if isSuperAdmin();
    }


    /* =========================================================
       AGGREGATED ANALYTICS
       
       No individual private content here.
       ========================================================= */

    match /deens_analytics/{analyticsId} {
      // Explicit Deen Friends Super Admin override.
      allow read, create, update, delete: if isSuperAdmin();



      allow read:
        if
          isAnalyticsAdmin()
          || isTrustSafetyAdmin()
          || isSuperAdmin();

      allow create, update:
        if
          isAnalyticsAdmin()
          || isTrustSafetyAdmin()
          || isSuperAdmin();

      allow delete:
        if isSuperAdmin();
    }


    /* =========================================================
       ADMIN INVESTIGATION EVIDENCE
       ========================================================= */

    match /deens_case_evidence/{evidenceId} {
      // Explicit Deen Friends Super Admin override.
      allow read, create, update, delete: if isSuperAdmin();



      allow read:
        if
          isTrustSafetyAdmin()
          || isSuperAdmin();

      allow create:
        if
          isTrustSafetyAdmin()
          || isSuperAdmin();

      allow update:
        if
          isTrustSafetyAdmin()
          || isSuperAdmin();

      allow delete:
        if isSuperAdmin();
    }


    /* =========================================================
       ADMIN USER NOTES
       
       Internal moderation/support notes.
       ========================================================= */

    match /deens_admin_user_notes/{noteId} {
      // Explicit Deen Friends Super Admin override.
      allow read, create, update, delete: if isSuperAdmin();



      allow read:
        if
          isSupportAdmin()
          || isTrustSafetyAdmin()
          || isSuperAdmin();

      allow create:
        if
          isSupportAdmin()
          || isTrustSafetyAdmin()
          || isSuperAdmin();

      allow update:
        if
          isSupportAdmin()
          || isTrustSafetyAdmin()
          || isSuperAdmin();

      allow delete:
        if isTrustSafetyAdmin()
          || isSuperAdmin();
    }



    /* =========================================================
       DAILY DEEN CHALLENGES (V2)

       Created and managed by Community / Trust & Safety admins
       (and the Super Admin). challengeType is always 'daily_deen',
       which keeps them separate from friend challenges
       (deens_friend_messages, kind 'challenge').

       Users may read a challenge only when it is published AND
       addressed to everyone or to them. Each user writes only
       their own progress document.
       ========================================================= */

    function validDailyChallenge(d) {
      return d.keys().hasAll([
          'challengeType','title','description','instructions','category','activity',
          'target','startDate','endDate','requiredDays','status','audience','assignedUids',
          'updatedBy','updatedAt','updatedAtMs'
        ])
        && d.keys().hasOnly([
          'challengeType','title','description','instructions','category','activity',
          'target','startDate','endDate','requiredDays','status','audience','assignedUids',
          'updatedBy','updatedAt','updatedAtMs','createdBy','createdAt'
        ])
        && d.challengeType == 'daily_deen'
        && isString(d.title, 80) && d.title.size() >= 3
        && isString(d.description, 400)
        && isString(d.instructions, 1000)
        && isString(d.category, 30)
        && d.activity in ['manual', 'tasbih']
        && d.target is int && d.target >= 1 && d.target <= 10000
        && d.startDate is string && d.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.endDate is string && d.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.endDate >= d.startDate
        && d.requiredDays is int && d.requiredDays >= 1 && d.requiredDays <= 90
        && d.status in ['draft', 'published', 'archived']
        && d.audience in ['all', 'selected']
        && d.assignedUids is list && d.assignedUids.size() <= 200
        && (d.audience == 'all' || d.assignedUids.size() >= 1)
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time
        && d.updatedAtMs is int;
    }

    function dailyChallengeVisibleTo(data) {
      return data.status == 'published'
        && (data.audience == 'all' || data.assignedUids.hasAny([request.auth.uid]));
    }

    match /deens_daily_challenges/{challengeId} {

      allow read:
        if isCommunityAdmin()
        || (signedIn() && dailyChallengeVisibleTo(resource.data));

      allow create:
        if isCommunityAdmin()
        && validDailyChallenge(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update:
        if isCommunityAdmin()
        && validDailyChallenge(request.resource.data)
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');

      allow delete:
        if isTrustSafetyAdmin();

      match /participants/{uid} {

        allow read:
          if isOwner(uid) || isCommunityAdmin();

        allow create, update:
          if isOwner(uid)
          && dailyChallengeVisibleTo(get(/databases/$(database)/documents/deens_daily_challenges/$(challengeId)).data)
          && request.resource.data.keys().hasOnly([
               'uid','challengeId','completedDates','completedCount',
               'lastCompletedDate','status','updatedAt','updatedAtMs'
             ])
          && request.resource.data.uid == uid
          && request.resource.data.challengeId == challengeId
          && request.resource.data.completedDates is list
          && request.resource.data.completedDates.size() <= 120
          && request.resource.data.completedCount == request.resource.data.completedDates.size()
          && request.resource.data.lastCompletedDate is string
          && request.resource.data.status in ['active', 'completed']
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedAtMs is int;

        allow delete:
          if isOwner(uid) || isTrustSafetyAdmin();
      }
    }


    /* =========================================================
       OFFICIAL RISE CONVERSATIONS (V2)

       One private thread per user with the RiseUponDeen team:
         deens_rise_threads/{uid}
         deens_rise_threads/{uid}/messages/{messageId}

       - Only the owner and support-level admins can read it
         (least privilege: Analytics admins and Viewers cannot).
       - A user can only write messages from 'user'.
       - Only support admins can write messages from 'rise'.
       - The single automated welcome message has the fixed id
         'welcome' and exactly this text, so it is created once.
       - Messages are never edited; they are deleted only by the
         Super Admin.
       ========================================================= */

    function riseWelcomeText() {
      return 'Assalamu alaikum! This is your private conversation with the RiseUponDeen team. Share a question, a suggestion, something you are struggling with, or a problem with the app. A member of the team reads every message and replies here, in sha Allah. This first message is automated.';
    }

    function riseThreadKeysOk(d) {
      return d.keys().hasOnly([
        'uid','displayName','username','lastMessagePreview','lastFrom','lastMessageAtMs',
        'unreadByUser','unreadByRise','status','createdAt','updatedAt',
        // V3 retention (Section 8): when each side last saw the conversation, status changes, clears
        'userSeenAtMs','riseSeenAtMs','statusChangedAtMs','clearedAtMs','clearedBy'
      ]);
    }

    function riseSeenOk(v) {
      return v is int && v <= request.time.toMillis() + 60000;
    }

    function riseThreadFieldsOk(d, uid) {
      return d.uid == uid
        && isString(d.displayName, 50)
        && isString(d.username, 50)
        && isString(d.lastMessagePreview, 160)
        && d.lastFrom in ['user', 'rise']
        && d.lastMessageAtMs is int
        && d.unreadByUser is int && d.unreadByUser >= 0 && d.unreadByUser <= 999
        && d.unreadByRise is int && d.unreadByRise >= 0 && d.unreadByRise <= 999
        && d.status in ['open', 'resolved']
        && d.updatedAt == request.time;
    }

    match /deens_rise_threads/{uid} {

      allow read:
        if isOwner(uid) || isSupportAdmin();

      allow create:
        if isOwner(uid)
        && riseThreadKeysOk(request.resource.data)
        && riseThreadFieldsOk(request.resource.data, uid)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;

      // Owner: their own summary fields; can raise unreadByRise by at most one per write
      // and can never change status or createdAt.
      allow update:
        if (
            isOwner(uid)
            && riseThreadKeysOk(request.resource.data)
            && riseThreadFieldsOk(request.resource.data, uid)
            && request.resource.data.status == resource.data.status
            && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
            && request.resource.data.unreadByRise <= resource.data.unreadByRise + 1
            // the user may only move their own "seen" marker; the support side's fields are theirs
            && request.resource.data.get('riseSeenAtMs', 0) == resource.data.get('riseSeenAtMs', 0)
            && request.resource.data.get('clearedAtMs', 0) == resource.data.get('clearedAtMs', 0)
            && request.resource.data.get('clearedBy', '') == resource.data.get('clearedBy', '')
            && request.resource.data.get('statusChangedAtMs', 0) == resource.data.get('statusChangedAtMs', 0)
            && (
              request.resource.data.get('userSeenAtMs', 0) == resource.data.get('userSeenAtMs', 0)
              || riseSeenOk(request.resource.data.userSeenAtMs)
            )
          )
          || (
            isSupportAdmin()
            && riseThreadKeysOk(request.resource.data)
            && riseThreadFieldsOk(request.resource.data, uid)
            && request.resource.data.displayName == resource.data.displayName
            && request.resource.data.username == resource.data.username
            && request.resource.data.get('userSeenAtMs', 0) == resource.data.get('userSeenAtMs', 0)
            && (
              request.resource.data.get('riseSeenAtMs', 0) == resource.data.get('riseSeenAtMs', 0)
              || riseSeenOk(request.resource.data.riseSeenAtMs)
            )
            && (
              request.resource.data.get('clearedBy', '') == resource.data.get('clearedBy', '')
              || request.resource.data.clearedBy == request.auth.uid
            )
          );

      allow delete:
        if isSuperAdmin();

      match /messages/{messageId} {

        allow read:
          if isOwner(uid) || isSupportAdmin();

        allow create:
          if request.resource.data.keys().hasOnly([
               'from','senderUid','adminUid','text','automated','createdAt','createdAtMs'
             ])
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdAtMs is int
          && request.resource.data.automated is bool
          && (
            // the user's own message
            (
              isOwner(uid)
              && messageId != 'welcome'
              && request.resource.data.from == 'user'
              && request.resource.data.senderUid == uid
              && request.resource.data.automated == false
              && !('adminUid' in request.resource.data)
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 2000
            )
            ||
            // the one-time automated welcome (fixed id and fixed text)
            (
              isOwner(uid)
              && messageId == 'welcome'
              && request.resource.data.from == 'rise'
              && request.resource.data.senderUid == uid
              && request.resource.data.automated == true
              && request.resource.data.text == riseWelcomeText()
            )
            ||
            // a reply from the RISE support team
            (
              isSupportAdmin()
              && messageId != 'welcome'
              && request.resource.data.from == 'rise'
              && request.resource.data.senderUid == request.auth.uid
              && request.resource.data.adminUid == request.auth.uid
              && request.resource.data.automated == false
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 2000
            )
          );

        allow update:
          if false;

        // V3 "Clear Chat": support admins may delete messages of a conversation that is marked
        // solved; the one-time automated welcome is always kept. Automatic 24-hour retention runs in
        // the trusted scheduler (Admin SDK), which is not subject to these rules.
        allow delete:
          if isSuperAdmin()
          || (
            isSupportAdmin()
            && messageId != 'welcome'
            && get(/databases/$(database)/documents/deens_rise_threads/$(uid)).data.status == 'resolved'
          );
      }
    }


    /* =========================================================
       DEEN FRIENDS PUSH DEVICES (V2)

       deens_push_devices/{uid}/devices/{deviceId}
       Links a device's FCM registration token to a signed-in
       Deen Friends user so the trusted scheduler (Admin SDK,
       push-scheduler/) can notify them of friend requests,
       messages, RISE replies and challenges.

       Only the owner can read or write their devices, so nobody
       can attach their token to another user. Clients never send
       notifications; only the server (Admin SDK) reads these.
       ========================================================= */

    match /deens_push_devices/{uid}/devices/{deviceId} {

      allow read, delete:
        if isOwner(uid);

      allow create, update:
        if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'uid','deviceId','fcmToken','platform','categories','active','updatedAt','updatedAtMs'
           ])
        && request.resource.data.uid == uid
        && request.resource.data.deviceId == deviceId
        && isString(deviceId, 120)
        && isString(request.resource.data.fcmToken, 4096)
        && isString(request.resource.data.platform, 30)
        && request.resource.data.categories is map
        && request.resource.data.categories.keys().hasOnly(['friendRequests','friendActivity','rise','challenges'])
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedAtMs is int;
    }


    /* =========================================================
       V3 · PUBLIC DISCOVERY CARDS AND FRIEND SUGGESTIONS (Section 9)

       deens_public_profiles/{uid}: the minimum needed to suggest a
       member (name, username, avatar). Readable by signed-in members
       only while the owner keeps `discoverable` on. No email or
       private fields can be stored here.
       deens_suggestions/{uid}: written only by the trusted scheduler.
       ========================================================= */

    match /deens_public_profiles/{uid} {
      allow read:
        if isOwner(uid)
        || (signedIn() && resource.data.discoverable == true)
        || isTrustSafetyAdmin();

      allow create, update:
        if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'uid','username','usernameKey','displayName','avatar','avatarConfig','discoverable','lastActiveDay','updatedAt'
           ])
        && request.resource.data.uid == uid
        && request.resource.data.username == userDoc(uid).username
        && request.resource.data.usernameKey == userDoc(uid).usernameKey
        && isString(request.resource.data.displayName, 50)
        && isString(request.resource.data.avatar, 20)
        && validAvatarConfig(request.resource.data.get('avatarConfig', null))
        && request.resource.data.discoverable is bool
        && request.resource.data.lastActiveDay is int
        && request.resource.data.lastActiveDay <= istDay() + 1
        && request.resource.data.updatedAt == request.time;

      allow delete:
        if isOwner(uid) || isTrustSafetyAdmin();
    }

    match /deens_suggestions/{uid} {
      allow read:
        if isOwner(uid);
      allow write:
        if false;
    }


    /* =========================================================
       V3 · CHALLENGE STREAKS AND THE MONTHLY LEADERBOARD
       (Sections 7 and 18) — see features/deen-friends/services/
       progressService.ts for the scoring rules shown to users.

       Each document can only change in the SAME write that records a
       genuine challenge completion (completionHappened). The rules
       re-check the arithmetic, the IST day and month from the server
       clock, at most 3 points per day, and that a completion source
       is never counted twice.
       ========================================================= */

    match /deens_activity/{activityId} {
      allow read:
        if (signedIn() && activityId.split('_')[0] == request.auth.uid) || isTrustSafetyAdmin();

      allow create:
        if signedIn()
        && activityId == request.auth.uid + '_' + string(istDay())
        && request.resource.data.keys().hasOnly(['uid','dayIndex','monthId','count','sources','updatedAt','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.dayIndex == istDay()
        && request.resource.data.monthId == istMonth()
        && request.resource.data.count == 1
        && request.resource.data.sources is list
        && request.resource.data.sources.size() == 1
        && isString(request.resource.data.sources[0], 200)
        && completionHappened(request.auth.uid, request.resource.data.sources[0])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdAt == request.time;

      allow update:
        if signedIn()
        && activityId == request.auth.uid + '_' + string(istDay())
        && request.resource.data.keys().hasOnly(['uid','dayIndex','monthId','count','sources','updatedAt','createdAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count','sources','updatedAt'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= 3
        && request.resource.data.sources.size() == resource.data.sources.size() + 1
        && request.resource.data.sources.hasAll(resource.data.sources)
        && !resource.data.sources.hasAny([request.resource.data.sources[request.resource.data.sources.size() - 1]])
        && isString(request.resource.data.sources[request.resource.data.sources.size() - 1], 200)
        && completionHappened(request.auth.uid, request.resource.data.sources[request.resource.data.sources.size() - 1])
        && request.resource.data.updatedAt == request.time;

      allow delete:
        if isSuperAdmin();
    }

    match /deens_streaks/{uid} {
      allow read:
        if isOwner(uid)
        || (signedIn() && resource.data.visible == true)
        || isTrustSafetyAdmin();

      allow create, update:
        if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid','current','longest','lastDayIndex','totalDays','visible','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.visible is bool
        && request.resource.data.updatedAt == request.time
        && (
          // a new active day: only together with today's first completion
          (
            !exists(activityPath(uid))
            && existsAfter(activityPath(uid))
            && request.resource.data.lastDayIndex == istDay()
            && request.resource.data.current
                 == (resource != null && resource.data.lastDayIndex == istDay() - 1 ? resource.data.current + 1 : 1)
            && request.resource.data.longest
                 == (request.resource.data.current > (resource == null ? 0 : resource.data.longest)
                       ? request.resource.data.current
                       : (resource == null ? 0 : resource.data.longest))
            && request.resource.data.totalDays == (resource == null ? 0 : resource.data.totalDays) + 1
          )
          ||
          // privacy only: show or hide the streak
          (
            resource != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visible','updatedAt'])
          )
        );

      allow delete:
        if isSuperAdmin();
    }

    match /deens_leaderboard/{monthId}/entries/{uid} {
      allow read:
        if isOwner(uid)
        || (signedIn() && resource.data.visible == true)
        || isTrustSafetyAdmin();

      allow create, update:
        if isOwner(uid)
        && request.resource.data.keys().hasOnly([
             'uid','monthId','points','activeDays','completions','lastAtMs',
             'displayName','username','avatar','avatarConfig','visible','updatedAt'
           ])
        && request.resource.data.uid == uid
        && request.resource.data.monthId == monthId
        && request.resource.data.displayName == userDoc(uid).displayName
        && isString(request.resource.data.avatar, 20)
        && validAvatarConfig(request.resource.data.get('avatarConfig', null))
        && request.resource.data.visible is bool
        && request.resource.data.updatedAt == request.time
        && (
          // a point: only in the same write as a counted completion today
          (
            monthId == istMonth()
            && request.resource.data.username == userDoc(uid).username
            && existsAfter(activityPath(uid))
            && getAfter(activityPath(uid)).data.count
                 == (exists(activityPath(uid)) ? get(activityPath(uid)).data.count + 1 : 1)
            && request.resource.data.points == (resource == null ? 0 : resource.data.points) + 1
            && request.resource.data.completions == (resource == null ? 0 : resource.data.completions) + 1
            && request.resource.data.activeDays
                 == (resource == null ? 0 : resource.data.activeDays) + (exists(activityPath(uid)) ? 0 : 1)
            && request.resource.data.lastAtMs is int
            && request.resource.data.lastAtMs <= request.time.toMillis() + 60000
          )
          ||
          // privacy / public name refresh only
          (
            resource != null
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['visible','displayName','avatar','avatarConfig','updatedAt'])
          )
        );

      allow delete:
        if isSuperAdmin();
    }


    /* =========================================================
       V3 · CIRCLE CHALLENGES (user-created, Section 18)

       Created by a member for up to 8 of their Deen Friends; at most
       3 per creator per IST day (id = uid_day_0..2). Participants
       write only their own progress: once per IST day, between the
       start and end dates, after accepting, never beyond the required
       days.
       ========================================================= */

    match /deens_user_challenges/{challengeId} {
      allow read:
        if signedIn() && (
          resource == null
            ? challengeId.split('_')[0] == request.auth.uid
            : (resource.data.creatorUid == request.auth.uid || resource.data.invitedUids.hasAny([request.auth.uid]))
        )
        || isTrustSafetyAdmin();

      allow create:
        if signedIn()
        && challengeId.matches(request.auth.uid + '_' + string(istDay()) + '_[0-2]')
        && request.resource.data.keys().hasOnly([
             'creatorUid','title','description','criteria','category','startDate','endDate',
             'requiredDays','invitedUids','visibility','status','createdAt','createdAtMs'
           ])
        && request.resource.data.creatorUid == request.auth.uid
        && isString(request.resource.data.title, 80) && request.resource.data.title.size() >= 3
        && isString(request.resource.data.description, 300)
        && isString(request.resource.data.criteria, 200) && request.resource.data.criteria.size() >= 3
        && isString(request.resource.data.category, 30)
        && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.startDate >= istDate()
        && request.resource.data.endDate >= request.resource.data.startDate
        && request.resource.data.requiredDays is int
        && request.resource.data.requiredDays >= 1
        && request.resource.data.requiredDays <= 60
        && request.resource.data.invitedUids is list
        && request.resource.data.invitedUids.size() >= 1
        && request.resource.data.invitedUids.size() <= 8
        && request.resource.data.invitedUids.toSet().size() == request.resource.data.invitedUids.size()
        && !request.resource.data.invitedUids.hasAny([request.auth.uid])
        && allFriends(request.auth.uid, request.resource.data.invitedUids, 0)
        && request.resource.data.visibility == 'invited'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdAtMs is int;

      allow update:
        if signedIn()
        && resource.data.creatorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status == 'cancelled';

      allow delete:
        if isTrustSafetyAdmin();

      match /participants/{pid} {
        allow read:
          if isOwner(pid)
          || (
            signedIn() && (
              get(/databases/$(database)/documents/deens_user_challenges/$(challengeId)).data.creatorUid == request.auth.uid
              || get(/databases/$(database)/documents/deens_user_challenges/$(challengeId)).data.invitedUids.hasAny([request.auth.uid])
            )
          )
          || isTrustSafetyAdmin();

        // accept / decline (also the creator's own record, written with the challenge)
        allow create:
          if isOwner(pid)
          && request.resource.data.keys().hasOnly(['uid','challengeId','status','completedDates','completedCount','updatedAt'])
          && request.resource.data.uid == pid
          && request.resource.data.challengeId == challengeId
          && (
            getAfter(/databases/$(database)/documents/deens_user_challenges/$(challengeId)).data.creatorUid == pid
            || getAfter(/databases/$(database)/documents/deens_user_challenges/$(challengeId)).data.invitedUids.hasAny([pid])
          )
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.completedDates.size() == 0
          && request.resource.data.completedCount == 0
          && request.resource.data.updatedAt == request.time;

        allow update:
          if isOwner(pid)
          && request.resource.data.keys().hasOnly(['uid','challengeId','status','completedDates','completedCount','updatedAt'])
          && request.resource.data.uid == pid
          && request.resource.data.challengeId == challengeId
          && request.resource.data.updatedAt == request.time
          && (
            // change of mind before any progress
            (
              resource.data.completedCount == 0
              && request.resource.data.completedCount == 0
              && request.resource.data.completedDates.size() == 0
              && request.resource.data.status in ['accepted', 'declined']
            )
            ||
            // one completed IST day, inside the dates, while active and accepted
            (
              resource.data.status == 'accepted'
              && request.resource.data.status == 'accepted'
              && get(/databases/$(database)/documents/deens_user_challenges/$(challengeId)).data.status == 'active'
              && request.resource.data.completedCount == resource.data.completedCount + 1
              && request.resource.data.completedCount
                   <= get(/databases/$(database)/documents/deens_user_challenges/$(challengeId)).data.requiredDays
              && request.resource.data.completedDates.size() == request.resource.data.completedCount
              && request.resource.data.completedDates.hasAll(resource.data.completedDates)
              && !resource.data.completedDates.hasAny([istDate()])
              && request.resource.data.completedDates[request.resource.data.completedDates.size() - 1] == istDate()
              && get(/databases/$(database)/documents/deens_user_challenges/$(challengeId)).data.startDate <= istDate()
              && get(/databases/$(database)/documents/deens_user_challenges/$(challengeId)).data.endDate >= istDate()
            )
          );

        allow delete:
          if isTrustSafetyAdmin();
      }
    }


    /* =========================================================
       V3 · DEEN CIRCLES (group chats, Section 19)

       At least 4 participants including the creator (checked here,
       not only in the app), no duplicates, and everyone added must
       already be the adder's Deen Friend. Messages follow the same
       no-free-text policy as one-to-one chats.
       ========================================================= */

    function groupData(groupId) {
      return get(/databases/$(database)/documents/deens_groups/$(groupId)).data;
    }

    match /deens_groups/{groupId} {
      allow read:
        if (signedIn() && resource.data.members.hasAny([request.auth.uid])) || isTrustSafetyAdmin();

      allow create:
        if signedIn()
        && groupId.matches('^g_[a-z0-9]{8,40}$')
        && request.resource.data.keys().hasOnly([
             'name','avatar','ownerUid','members','admins','memberCount',
             'lastMessageAtMs','lastPreview','createdAt','createdAtMs','updatedAt'
           ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.admins == [request.auth.uid]
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 4
        && request.resource.data.members.size() <= 8
        && request.resource.data.members[0] == request.auth.uid
        && request.resource.data.members.toSet().size() == request.resource.data.members.size()
        && allFriends(request.auth.uid, request.resource.data.members, 1)
        && request.resource.data.memberCount == request.resource.data.members.size()
        && isString(request.resource.data.name, 40) && request.resource.data.name.size() >= 2
        && isString(request.resource.data.avatar, 20)
        && request.resource.data.lastMessageAtMs is int
        && isString(request.resource.data.lastPreview, 120)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdAtMs is int
        && request.resource.data.updatedAt == request.time;

      allow update:
        if signedIn()
        && resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.updatedAt == request.time
        && (
          // a member posted: last activity only
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAtMs','lastPreview','updatedAt'])
            && request.resource.data.lastMessageAtMs is int
            && isString(request.resource.data.lastPreview, 120)
          )
          ||
          // an admin renames the circle
          (
            resource.data.admins.hasAny([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','updatedAt'])
            && isString(request.resource.data.name, 40) && request.resource.data.name.size() >= 2
          )
          ||
          // an admin adds one of their Deen Friends
          (
            resource.data.admins.hasAny([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','memberCount','updatedAt'])
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.members.size() <= 30
            && request.resource.data.members.hasAll(resource.data.members)
            && !resource.data.members.hasAny([request.resource.data.members[request.resource.data.members.size() - 1]])
            && isFriendOf(request.auth.uid, request.resource.data.members[request.resource.data.members.size() - 1])
            && request.resource.data.memberCount == request.resource.data.members.size()
          )
          ||
          // someone leaves, or an admin removes a member (never the creator)
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','admins','memberCount','ownerUid','updatedAt'])
            && request.resource.data.members.size() == resource.data.members.size() - 1
            && resource.data.members.hasAll(request.resource.data.members)
            && request.resource.data.memberCount == request.resource.data.members.size()
            && request.resource.data.members.hasAll(request.resource.data.admins)
            && (request.resource.data.members.size() == 0 || request.resource.data.admins.size() >= 1)
            && (
              !request.resource.data.members.hasAny([request.auth.uid])
              || (
                resource.data.admins.hasAny([request.auth.uid])
                && request.resource.data.members.hasAny([resource.data.ownerUid])
                && request.resource.data.ownerUid == resource.data.ownerUid
              )
            )
          )
        );

      allow delete:
        if isTrustSafetyAdmin();

      match /messages/{messageId} {
        allow read:
          if (signedIn() && groupData(groupId).members.hasAny([request.auth.uid])) || isTrustSafetyAdmin();

        allow create:
          if signedIn()
          && groupData(groupId).members.hasAny([request.auth.uid])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdAtMs is int
          && (
            (
              request.resource.data.kind == 'encourage'
              && request.resource.data.keys().hasOnly(['senderUid','kind','text','createdAt','createdAtMs'])
              && request.resource.data.text in [
                "MashaAllah, keep going.",
                "May Allah make it easy for you.",
                "Keep your Qur'an streak alive.",
                "Alhamdulillah.",
                "May Allah accept it from you.",
                "Ameen 🤲",
                "JazakAllahu khayran 💚",
                "BarakAllahu feek ✨",
                "SubhanAllah 🌙"
              ]
            )
            ||
            (
              request.resource.data.kind == 'content'
              && request.resource.data.keys().hasOnly(['senderUid','kind','text','sharedContent','createdAt','createdAtMs'])
              && request.resource.data.text == ''
              && validSharedContent(request.resource.data.sharedContent)
            )
          );

        allow update:
          if false;

        allow delete:
          if (signedIn() && resource.data.senderUid == request.auth.uid) || isTrustSafetyAdmin();
      }
    }


    /* =========================================================
       V3 · APP GUIDE CONFIGURATION (Section 13)

       The published walkthrough is public (read once per session);
       drafts and publishing are for community-level admins only.
       ========================================================= */

    match /rud_app_guides/{docId} {
      allow read:
        if docId == 'published' || isCommunityAdmin();

      allow create, update:
        if isCommunityAdmin()
        && docId in ['draft', 'published']
        && request.resource.data.enabled is bool
        && request.resource.data.version is int
        && request.resource.data.tours is list
        && request.resource.data.tours.size() <= 24
        && isString(request.resource.data.firstRunTourId, 60)
        && request.resource.data.reshowOnVersion is int
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;

      allow delete:
        if isSuperAdmin();
    }

    /* =========================================================
       DEFAULT DENY
       
       Anything not explicitly listed above is blocked.
       ========================================================= */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}