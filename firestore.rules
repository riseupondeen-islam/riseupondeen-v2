          isSuperAdmin();
    }


    /* =========================================================
       USER SUSPENSIONS
       ========================================================= */

    match /deens_user_suspensions/{suspensionId} {
      // Explicit Deen Friends Super Admin override.
      allow read, create, update, delete: if isSuperAdmin();



      allow read:
        if
          (
            signedIn() &&
            resource.data.uid == request.auth.uid
          )
          ||
          isTrustSafetyAdmin()
          ||
          isSuperAdmin();

      allow create:
